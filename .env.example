# Copiá este archivo como .env.local y completá los valores.
# (En Vercel van en Settings → Environment Variables.)

# Cadena de conexión de Neon (Dashboard de Neon → Connect → copiar "Connection string")
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Frase larga y secreta para firmar las sesiones (cualquier texto largo y al azar)
JWT_SECRET=cambiame-por-una-frase-larga-y-secreta
